<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Assignment_3.MainPage">

    <ContentPage.Resources>

        <Color x:Key="itemColor">#000000</Color>
        <Color x:Key="priceColor">#ff0000</Color>
        <Color x:Key="stockColor">#00ff00</Color>
        <Color x:Key="noStockColor"> #ff0000</Color>

        <Style TargetType="Label" x:Key="itemName">
            <Setter Property ="TextColor" Value="{StaticResource itemColor}"/>
            <Setter Property="FontSize" Value="20"/>
        </Style>

        <Style TargetType="Label" x:Key="itemPrice">
            <Setter Property="TextColor" Value="{StaticResource priceColor}"/>
            <Setter Property="FontSize" Value="20"/>
        </Style>
        <Style TargetType="Label" x:Key="itemStock">
            <Setter Property="TextColor" Value="{StaticResource stockColor}"/>
            <Setter Property="FontSize" Value="18"/>


        </Style>
        
    </ContentPage.Resources>
    <ScrollView>
        <VerticalStackLayout>
            <CollectionView x:Name="itemList"
            SelectionMode="Single"
            SelectionChanged="OnItemSelected">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Label Text="{Binding .}" FontSize="20" HorizontalTextAlignment="Center" />
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>


</ContentPage>
