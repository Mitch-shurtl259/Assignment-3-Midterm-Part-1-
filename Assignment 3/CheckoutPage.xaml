<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Assignment_3.CheckoutPage">
    <VerticalStackLayout Padding="35" Spacing="65">

        <Label Text="Your Cart"
                FontSize="24"
                FontAttributes="Bold" />

        <Label Text="Nothing in here yet"
                FontSize="10"/>
        
        <Label Text="Total: $0.00"
               FontAttributes="Bold"
               FontSize="18"
               HorizontalOptions= "End"/>


        

        <Button Text="Checout" 
                    Clicked="CheckoutButtonClicked" 
                    WidthRequest="1000"/>
       
        
    </VerticalStackLayout>
</ContentPage>