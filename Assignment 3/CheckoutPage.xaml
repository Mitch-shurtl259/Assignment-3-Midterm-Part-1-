<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Assignment_3.CheckoutPage">
    <Grid RowDefinitions="Auto,*,Auto,Auto,Auto"
          Padding="24"
          RowSpacing="16">

        <Label Grid.Row="0" Text="Checkout"
                FontSize="24"
                FontAttributes="Bold" />
        <Border Grid.Row="1"
                Padding="4"
                StrokeThickness="1"
                Stroke="Gray">

            <CollectionView x:Name="cartList">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <VerticalStackLayout Padding="10">
                            <Label Text="{Binding Name}" />
                            <Label Text="{Binding Quantity}" />
                            <Label Text="{Binding Price}" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <Label Text="Your cart is empty." 
                    FontSize="16" 
                    HorizontalOptions="Center"/>
                </CollectionView.EmptyView>
            </CollectionView>
        </Border>

        <Label Grid.Row="2" Text="Total: $0.00"
               FontAttributes="Bold"
               FontSize="18"
               HorizontalOptions= "End"/>


        <Button Grid.Row="3" Text="Checkout" 
                    Clicked="CheckoutButtonClicked" 
                    WidthRequest="1000"/>

        <Label Grid.Row="4" x:Name="checkoutLabel"
               HorizontalOptions="Center"/>

    </Grid>
</ContentPage>